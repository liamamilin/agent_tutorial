# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入你的配置
#
# 注释规则（python-dotenv）：
#   1. 整行 # 开头 → 整行忽略
#   2. 行尾注释要求 "#" 前必须有空格：KEY=value # 注释
#      写成 KEY=value#注释 会被当成值的一部分，导致取值出错
#   3. 引号内的 # 不算注释：KEY="value # 注释"
#
# 代码里实际读取的变量：
#   OPENAI_API_KEY / LLM_BASE_URL / LLM_MODEL_ID
#   OPENAI_CUSTOM_HEADERS（仅 OpenCode Go 需要，其他服务可留空）
# ============================================================

# --- OpenAI 官方 ---
OPENAI_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini

# --- 本地 Ollama ---
# 切换方法：注释掉上面三行，取消下面几行的注释
# OPENAI_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_ID=qwen3:14b

# --- 其他兼容 OpenAI 接口的服务 ---
# OPENAI_API_KEY=your-api-key
# LLM_BASE_URL=https://your-service.com/v1
# LLM_MODEL_ID=your-model-name

# --- OpenCode Go（可选）---
# Go 网关要求带上 x-opencode-session，否则返回 400 MissingSessionID
# 格式：每行一个 "请求头名: 值"
# OPENAI_CUSTOM_HEADERS=x-opencode-session: 换成你的-uuid
